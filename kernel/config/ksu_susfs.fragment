# ReSukiSU + susfs4ksu defconfig fragment.
# Merged on top of `gki_defconfig vendor/peridot_GKI.config` by 03_build.sh.
#
# ReSukiSU's hook-strategy is a Kconfig `choice` block with three options:
#   KSU_TRACEPOINT_HOOK / KSU_MANUAL_HOOK / KSU_SUSFS
# We pick KSU_SUSFS = "SUSFS Inline Hook" because we have the susfs4ksu
# kernel patches applied (see 02_patch.sh). All seven ksu_handle_*
# inline hooks live in the kernel source tree after that patch lands;
# ReSukiSU's inline_hook_check.mk verifies their presence and fails the
# build loudly if any is missing.
#
# After flashing the kernel, install on device:
#   ReSukiSU Manager APK from https://github.com/ReSukiSU/ReSukiSU
#   (SUSFS UI is bundled in the manager — no separate sidex15/BRENE
#    module is required).

# --- ReSukiSU core ----------------------------------------------------------
CONFIG_KSU=y
CONFIG_KSU_DEBUG=n
CONFIG_KSU_DISABLE_MANAGER=n
CONFIG_KSU_DISABLE_POLICY=n
CONFIG_KSU_TOOLKIT_SUPPORT=y
CONFIG_KSU_FULL_NAME_FORMAT=y
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y

# KPM (Kernel Patch Module) — runtime-loadable kernel patches.
CONFIG_KPM=y

# --- Hook strategy: SUSFS Inline (one of the choice options) ---------------
# Selecting KSU_SUSFS automatically deselects KSU_TRACEPOINT_HOOK and
# KSU_MANUAL_HOOK because they're in the same `choice` block.
CONFIG_KSU_SUSFS=y

# --- SUSFS feature toggles (all default y, explicit for clarity) -----------
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y

# --- Build identification ---------------------------------------------------
CONFIG_LOCALVERSION="-PeridotReSukiSU"
